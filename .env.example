# Key de la API de heysteff (sk_live_… o sk_test_…): developers.heysteff.com/console → API keys.
# Permisos: conversations:read, conversations:write, messages:write y, para el tiempo real, events:read.
HEYSTEFF_API_KEY=

# Contraseña para entrar a la bandeja. Cualquiera que la tenga lee y contesta tus conversaciones:
# usa una larga.
INBOX_PASSWORD=

# Opcional. Bandeja de UN cliente de tu SaaS (el id de /v1/customers): muestra solo las
# conversaciones de los canales que conectó ese cliente con su link de conexión.
# HEYSTEFF_CUSTOMER_ID=

# Opcional. Idioma de la bandeja: es o en. Sin él, el del navegador.
# INBOX_LOCALE=es

# Opcional. Solo para apuntar a otro servidor de heysteff.
# HEYSTEFF_BASE_URL=https://app.heysteff.com/api
